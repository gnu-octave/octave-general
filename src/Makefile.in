MKOCTFILE := @MKOCTFILE@
OCTAVE_CONFIG := @OCTAVE_CONFIG@
CXXFLAGS  := @CXXFLAGS@ @DEFS@
LIBS      := @LIBS@
LDFLAGS   := @LDFLAGS@
GREP      := @GREP@
NETTLE_CFLAGS := @NETTLE_CFLAGS@
NETTLE_LIBS := @NETTLE_LIBS@

ARCHDIR   := "$(shell $(OCTAVE_CONFIG) -p CANONICAL_HOST_TYPE)-$(shell $(OCTAVE_CONFIG) -p API_VERSION)"

ifndef MKOCTFILE
MKOCTFILE := mkoctfile -Wall
endif

PROGS = $(patsubst %.cc,%.oct,$(wildcard *.cc))
TST_DIR    := ../inst/$(ARCHDIR)
CC_SOURCES  := $(wildcard *.cc)
CC_TST_SOURCES := $(shell $(GREP) --files-with-matches '^%!' $(CC_SOURCES))
TST_SOURCES := $(patsubst %.cc,${TST_DIR}/%.cc-tst,$(CC_TST_SOURCES))


all: $(PROGS) $(TST_SOURCES)

SHA1.oct: SHA1.cc
	$(MKOCTFILE) $< $(CXXFLAGS) $(NETTLE_CFLAGS) $(LDFLAGS) $(LIBS) $(NETTLE_LIBS)
%.oct: %.cc
	$(MKOCTFILE) $< $(CXXFLAGS) $(LDFLAGS) $(LIBS)

$(TST_DIR):
	@mkdir -p "$@"

$(TST_SOURCES): $(TST_DIR)/%.cc-tst: %.cc | $(TST_DIR)
	@echo "Extracting tests from $< ..."
	@$(RM) -f "$@" "$@-t"
	@(      echo "## Generated from $<"; \
	$(GREP) '^%!' "$<") > "$@"

clean:
	rm -f *.o octave-core core *.oct *~
	test -e $(TST_DIR) && rm -f $(TST_SOURCES) || true
	test -e $(TST_DIR) && rmdir $(TST_DIR) || true

distclean: clean
	rm -rf autom4te.cache
	rm -f Makefile config.status config.log config.h configure
